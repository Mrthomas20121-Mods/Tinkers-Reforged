{
  "multipart": [
    {
      "apply": {
        "model": "tinkers_reforged:block/platform/yttrium/both"
      },
      "when": {
        "down": "false",
        "up": "false"
      }
    },
    {
      "apply": {
        "model": "tinkers_reforged:block/platform/yttrium/top"
      },
      "when": {
        "down": "true",
        "up": "false"
      }
    },
    {
      "apply": {
        "model": "tinkers_reforged:block/platform/yttrium/bottom"
      },
      "when": {
        "down": "false",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "tinkers_reforged:block/platform/yttrium/neither"
      },
      "when": {
        "down": "true",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "tinkers_reforged:block/platform/yttrium/side",
        "y": 180
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "tinkers_reforged:block/platform/yttrium/side",
        "y": 270
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "tinkers_reforged:block/platform/yttrium/side"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "tinkers_reforged:block/platform/yttrium/side",
        "y": 90
      },
      "when": {
        "west": "true"
      }
    }
  ]
}